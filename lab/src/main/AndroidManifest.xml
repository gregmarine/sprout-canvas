<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        tools:replace on allowBackup is required by :canvas-onyx, not by this app. The Onyx SDK's
        AAR declares android:allowBackup="true" in its own manifest, so any consuming app that has
        an opinion about backup fails the manifest merge until it says which value wins. Worth
        knowing before it looks like a bug in the Lab: the error names this file, and the cause is
        a dependency two modules away.
    -->
    <application
        android:name=".LabApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SproutCanvasLab"
        tools:replace="android:allowBackup">

        <!--
            The launcher entry. The device tooling starts this component by name, so renaming it
            breaks every install script in .claude/skills/device-build-install.
        -->
        <activity
            android:name=".LabActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Each instrument gets its own Activity. `configChanges` is deliberately NOT set: a
            rotation must recreate these screens, because surviving one is exactly what G8 promises
            and a screen that dodged the recreation would be proving nothing.
        -->
        <activity
            android:name=".CanvasLabActivity"
            android:exported="false"
            android:label="@string/screen_canvas" />

        <activity
            android:name=".ToolsLabActivity"
            android:exported="false"
            android:label="@string/screen_tools" />

        <activity
            android:name=".OverlaysLabActivity"
            android:exported="false"
            android:label="@string/screen_overlays" />

        <activity
            android:name=".DeviceReportActivity"
            android:exported="false"
            android:label="@string/screen_device_report" />
    </application>
</manifest>
