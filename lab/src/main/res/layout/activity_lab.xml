<?xml version="1.0" encoding="utf-8"?>
<!--
    The Lab's home screen: what the library chose on this device, and a way into each instrument.

    Every screen below asks the library a different question, and each one exists because some
    acceptance criterion in PLAN.md §7 can only be answered by a human looking at a panel.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper_white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/ink_black"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/libraryVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/ink_light"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/engineSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="monospace"
            android:textColor="@color/ink_black"
            android:textIsSelectable="true"
            android:textSize="12sp" />

        <Button
            android:id="@+id/openCanvas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/screen_canvas" />

        <TextView
            style="@style/LabHint"
            android:text="@string/screen_canvas_hint" />

        <Button
            android:id="@+id/openTools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/screen_tools" />

        <TextView
            style="@style/LabHint"
            android:text="@string/screen_tools_hint" />

        <Button
            android:id="@+id/openOverlays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/screen_overlays" />

        <TextView
            style="@style/LabHint"
            android:text="@string/screen_overlays_hint" />

        <Button
            android:id="@+id/openDeviceReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/screen_device_report" />

        <TextView
            style="@style/LabHint"
            android:text="@string/screen_device_report_hint" />
    </LinearLayout>
</ScrollView>
