<?xml version="1.0" encoding="utf-8"?>
<!--
    Phase 0 placeholder. The real Lab shell — a screen chooser over Canvas / Tools / Overlays /
    Data / Device report / Conformance run — arrives with the screens themselves (PLAN.md §4.3).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/paper_white">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/ink_black"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/libraryVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/ink_black"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/phase_zero_note"
        android:textColor="@color/ink_light"
        android:textSize="14sp"
        android:gravity="center" />
</LinearLayout>
