<?xml version="1.0" encoding="utf-8"?>
<!--
    minSdk is 29, so every device that can install the Lab supports adaptive icons (API 26+).
    That is why there are no fallback PNG mipmaps here — this file is always the one used.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/paper_white" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
