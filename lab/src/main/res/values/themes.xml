<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        No ActionBar: the Lab's screens are instruments, and on e-ink every band of chrome costs
        panel area and a refresh. Screens supply their own headers where they need one.
    -->
    <style name="Theme.SproutCanvasLab" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper_white</item>
        <item name="android:statusBarColor">@color/paper_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Explanatory text: present when read deliberately, out of the way otherwise. -->
    <style name="LabHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/ink_light</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!--
        Controls sized for a stylus device held in one hand. Not all-caps: a row of nine pen names
        has to stay readable, and SMALL CAPS costs a third of the width for nothing.
    -->
    <style name="LabCompactButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- Host chrome over the canvas. Solid black so "written under" would be unmistakable. -->
    <style name="LabOverlay">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/ink_black</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">@color/paper_white</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
